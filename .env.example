# Copy to .env and adjust as needed
MEMORY_DATA_PATH=data/memories
MEMORY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_EMBED_DIM=384
MEMORY_API_HOST=127.0.0.1
MEMORY_API_PORT=8000
# Optional: require X-API-Key header on all API routes (empty = auth off)
MEMORY_API_KEY=
# Allowed browser origins for a future web UI
MEMORY_CORS_ORIGINS=http://localhost:3000
